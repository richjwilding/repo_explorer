{
  "name": "repo-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first app that helps engineering leaders get comfortable with an unfamiliar codebase: progressive architecture explainers, chat with the source, and rich commit/PR explainers.",
  "type": "module",
  "bin": {
    "repo-explorer": "./bin/repo-explorer.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "serve": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "dompurify": "^3.4.16",
    "fastify": "^5.12.5",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "mermaid": "^12.1.0",
    "picocolors": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
